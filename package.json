{
  "name": "sepbase-name-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.7.0"
  },
  "scripts": {
    "dev": "pnpm --filter @sepbase/web dev",
    "workspace:build-libs": "pnpm --filter @sepbase/sdk build && pnpm --filter @sepbase/mcp build && pnpm --filter @sepbase/react build",
    "build": "pnpm --filter @sepbase/sdk build && pnpm --filter @sepbase/mcp build && pnpm --filter @sepbase/react build && pnpm --filter @sepbase/web build",
    "prelint": "pnpm workspace:build-libs",
    "lint": "pnpm --filter @sepbase/sdk lint && pnpm --filter @sepbase/mcp lint && pnpm --filter @sepbase/react lint && pnpm --filter @sepbase/web lint",
    "pretypecheck": "pnpm workspace:build-libs",
    "typecheck": "pnpm --filter @sepbase/sdk typecheck && pnpm --filter @sepbase/mcp typecheck && pnpm --filter @sepbase/react typecheck && pnpm --filter @sepbase/example-v3-integrations typecheck && pnpm --filter @sepbase/web typecheck && tsc -p tsconfig.scripts.json --noEmit",
    "pretest": "pnpm workspace:build-libs",
    "test": "pnpm --filter @sepbase/sdk test && pnpm --filter @sepbase/mcp test && pnpm --filter @sepbase/react test && pnpm --filter @sepbase/web test",
    "contracts:fmt": "tsx scripts/forge.ts fmt --root contracts",
    "contracts:build": "tsx scripts/forge.ts build --root contracts",
    "contracts:sizes": "tsx scripts/forge.ts build --sizes --root contracts",
    "contracts:test": "tsx scripts/forge.ts test -vvv --root contracts",
    "contracts:deploy": "tsx scripts/deploy.ts",
    "contracts:metadata:v2": "tsx scripts/set-v2-metadata-uri.ts",
    "contracts:deploy:v3:safe": "tsx scripts/deploy-v3-safe.ts",
    "contracts:deploy:v3": "tsx scripts/deploy-v3.ts",
    "contracts:abi": "tsx scripts/export-abi.ts",
    "contracts:abi:v3": "tsx scripts/export-v3-abis.ts",
    "chain:check": "tsx scripts/chain-check.ts",
    "deployment:check": "tsx scripts/deployment-check.ts",
    "release:check": "tsx scripts/release-check.ts",
    "smoke:base-sepolia": "tsx scripts/base-sepolia-smoke.ts",
    "manifest:generate": "tsx scripts/generate-manifest.ts",
    "manifest:v3:draft": "tsx scripts/generate-v3-manifest.ts",
    "manifest:v3:promote": "tsx scripts/promote-v3-manifest.ts",
    "manifest:v3:promote:test": "tsx scripts/promote-v3-manifest.test.ts",
    "manifest:v3:live": "tsx scripts/promote-v3-live.ts",
    "manifest:v3:live:test": "tsx scripts/promote-v3-live.test.ts",
    "artifacts:v3:validate": "tsx scripts/validate-v3-artifacts.ts",
    "artifacts:v3:test": "tsx scripts/validate-v3-artifacts.test.ts",
    "artifacts:v3:check": "pnpm artifacts:v3:test && pnpm artifacts:v3:validate",
    "project:validate": "tsx scripts/validate-project.ts",
    "dependencies:validate": "tsx scripts/validate-dependency-pins.ts",
    "normalization:validate": "tsx scripts/validate-normalization-fixtures.ts",
    "migration:v3:test": "tsx scripts/v3-migration-dry-run.test.ts",
    "migration:v3:dry-run": "tsx scripts/v3-migration-dry-run.ts",
    "examples:v3:typecheck": "pnpm --filter @sepbase/example-v3-integrations typecheck",
    "packages:smoke": "tsx scripts/package-release-smoke.ts",
    "hosted:check": "tsx scripts/hosted-release-smoke.ts",
    "clone:reset": "tsx scripts/reset-clone.ts"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@safe-global/protocol-kit": "8.0.3",
    "@types/node": "22.20.1",
    "dotenv": "17.4.2",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "viem": "2.55.0",
    "zod": "4.4.3"
  }
}
