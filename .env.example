# Web - public; never place secret provider credentials in NEXT_PUBLIC_* values
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Comma-separated wallet addresses with read-only access to the admin workspace.
# The live contract owner and pending owner are always included automatically.
NEXT_PUBLIC_ADMIN_ADDRESSES=
# Required only when settlement.kind is "erc20"
NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=

# Server/deployment - never expose to browser
# Optional server-only RPC for API routes and production reads. Use this for
# authenticated provider URLs; the public manifest keeps NEXT_PUBLIC_RPC_URL.
RPC_URL=

# Local/hosted MCP. The remote Next.js route uses NEXT_PUBLIC_SITE_URL as its
# canonical manifest and allowed browser Origin. These values are for the stdio
# server and optional server-only RPC override; never publish authenticated RPCs.
SEPBASE_MANIFEST_URL=http://localhost:3000/.well-known/chain-name-service.json
SEPBASE_RPC_URL=

# V3 browser registration attestation proxy. Candidate/live releases only. The
# server authenticates to a reviewed external issuer and verifies every returned
# EIP-712 signature against the immutable manifest attestor. No raw signing key
# is supported here, and these values must never use a NEXT_PUBLIC_* prefix.
V3_NORMALIZATION_ATTESTATION_ISSUER_URL=
V3_NORMALIZATION_ATTESTATION_ISSUER_AUTH_TOKEN=

# x402 boundary. Free quotes are authenticated with a server-only HMAC. Paid
# execution source is activation-gated and still fails closed until a live,
# paid-enabled V3 manifest and every reviewed facilitator/CAS/signer/attestor,
# workflow, limit, monitoring and funded-E2E gate are present. Paid execution
# additionally requires one matching six-decimal ERC-20 settlement asset.
X402_REGISTRATION_ENABLED=false
X402_QUOTE_TTL_SECONDS=300
X402_QUOTE_HMAC_KEY_ID=
# Base64url-encoded 32-64 random bytes. Never expose this as NEXT_PUBLIC_*.
X402_QUOTE_HMAC_KEY=
X402_OPERATION_TIMEOUT_MS=30000
X402_LOCK_LEASE_SECONDS=300
X402_SITE_ORIGIN=http://localhost:3000
# Official no-setup test facilitator for Base Sepolia (`eip155:84532`). Replace
# it only with a separately reviewed facilitator when moving beyond testnet.
X402_FACILITATOR_URL=https://x402.org/facilitator
# Optional when the reviewed facilitator is public; otherwise use a server-only bearer token.
X402_FACILITATOR_AUTH_TOKEN=
X402_PAY_TO_ADDRESS=
X402_PAYMENT_ASSET_ADDRESS=
X402_KEEPER_ADDRESS=
# aws-kms | gcp-kms | azure-key-vault | turnkey | external
X402_KEEPER_SIGNER_PROVIDER=
X402_KEEPER_SIGNER_URL=
X402_KEEPER_SIGNER_AUTH_TOKEN=
X402_KEEPER_MAX_ORDER_BASE_UNITS=
X402_KEEPER_DAILY_LIMIT_BASE_UNITS=
X402_IDEMPOTENCY_STORE_URL=
X402_IDEMPOTENCY_STORE_AUTH_TOKEN=
X402_NORMALIZATION_ATTESTATION_URL=
X402_NORMALIZATION_ATTESTATION_AUTH_TOKEN=
X402_NORMALIZATION_PROFILE_REFERENCE=
X402_WORKFLOW_ENABLED=false
X402_WORKFLOW_BILLING_CONFIRMED=false
X402_WORKFLOW_FLUID_COMPUTE_CONFIRMED=false
X402_ABUSE_PROTECTION_CONFIRMED=false
X402_MONITORING_CONFIRMED=false
X402_RECONCILIATION_RUNBOOK_CONFIRMED=false
X402_INDEPENDENT_REVIEW_CONFIRMED=false
# Raw X402_KEEPER_PRIVATE_KEY values are forbidden and intentionally have no slot.

# Optional build provenance. Generators never infer a commit from a dirty worktree.
# CI providers may instead supply VERCEL_GIT_COMMIT_SHA or GITHUB_SHA.
SOURCE_COMMIT=

PRIVATE_KEY=
OWNER_ADDRESS=
TREASURY_ADDRESS=

# V3 Base Sepolia deployment profile. These public protocol parameters are
# consumed by contracts/script/DeployV3.s.sol. Keep the signer, owner, treasury,
# attestor and migration-window decisions empty until reviewed operational
# addresses/timestamps are available; the deployment must fail rather than use a
# placeholder authority.
COLLECTION_NAME=Sepbase Names V3
COLLECTION_SYMBOL=SEPBASE
NAME_SUFFIX=sepbase
SUFFIX_NODE=0x18b3df4e0664ed77d7813515c619c540141b6db573ff69ff1925a877d14b31d6
REVERSE_ROOT_NODE=0x91d1777781884d03a6757a803996e38de2a42967fb37eeaca72729271025a9e2
NORMALIZATION_PROFILE_HASH=0xdce87d511a5ad02a3ee50057259547c744098a0da6207c4dcea41f2a7cbea638
NORMALIZATION_ATTESTOR_ADDRESS=
V3_SUITE_CONFIGURATOR_ADDRESS=
# Empty for a classical EOA. If the configurator has an EIP-7702 designator,
# list only independently reviewed deployed delegation target addresses.
V3_ALLOWED_CONFIGURATOR_DELEGATION_TARGETS=
# Deterministic 2-of-2 governance Safe. Owner and treasury must be this same Safe.
V3_SAFE_OWNER_ADDRESSES=
V3_SAFE_THRESHOLD=2
V3_SAFE_VERSION=1.4.1
V3_SAFE_SALT_NONCE=
V3_SAFE_BROADCAST=false
# Comma-separated reviewed Safe contract addresses; the shared owner/treasury Safe must be listed.
V3_REVIEWED_MULTISIG_ADDRESSES=
V3_BROADCAST=false
GRACE_PERIOD_SECONDS=2592000
METADATA_BASE_URI=https://sepbase.vercel.app/api/metadata/
MIN_COMMITMENT_AGE_SECONDS=60
MAX_COMMITMENT_AGE_SECONDS=86400
MAX_NORMALIZATION_ATTESTATION_VALIDITY_SECONDS=900
SETTLEMENT_KIND=erc20
SETTLEMENT_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
ANNUAL_PRICE_BASE_UNITS=500
# Packed uint24: 1-char=100, 2-char=25, 3-char=5.
SHORT_NAME_PRICE_MULTIPLIERS=334180
REFERRAL_REWARD_BPS=1000
MARKETPLACE_FEE_BPS=0
MIN_BID_INCREMENT_BPS=500
AUCTION_EXTENSION_WINDOW_SECONDS=300
AUCTION_EXTENSION_DURATION_SECONDS=300
AUCTION_MAX_EXTENSIONS=6
LEGACY_V2_CONTRACT_ADDRESS=0xe000de3efe798Aa4F834fd952Bef35BAE1B16945
MIGRATION_START_TIMESTAMP=
MIGRATION_END_TIMESTAMP=
# A fixed V2 source block is mandatory for a reproducible migration dry run.
V3_MIGRATION_SOURCE_BLOCK=
# Optional repository-relative output, for example evidence/v3-migration/84532-<block>.json.
V3_MIGRATION_REPORT_PATH=

# Leave blank for chains natively supported by Foundry/Etherscan.
EXPLORER_API_URL=
EXPLORER_API_KEY=
EXPLORER_VERIFIER=etherscan
# Optional absolute path to forge when it is not available on PATH.
FORGE_BIN=
