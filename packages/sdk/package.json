    "test": "vitest run"
  },
  "dependencies": {
    "viem": "2.55.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
