{
  "name": "@sepbase/mcp",
  "version": "0.1.0",
  "description": "Read-only MCP tools and unsigned transaction preparation for SEPBASE deployments.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/yusufky63/sepbase.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://sepbase.vercel.app/developers",
  "bugs": { "url": "https://github.com/yusufky63/sepbase/security/advisories/new" },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./v3-http": {
      "types": "./dist/v3-http.d.ts",
      "import": "./dist/v3-http.js"
    }
  },
  "bin": {
    "mcp-server-sepbase": "./dist/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@sepbase/sdk": "workspace:*",
    "viem": "2.55.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
